#include <windows.h>

1 DIALOG 0, 0, 160, 60
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "MicroChat"
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
FONT 8, "MS Shell Dlg"
{
   LTEXT "Server IP:", -1, 8, 8, 60, 10 
   EDITTEXT 1001, 8, 20, 144, 12, ES_AUTOHSCROLL
   DEFPUSHBUTTON "OK", IDOK, 40, 40, 40, 14 
   PUSHBUTTON "Cancel", IDCANCEL, 80, 40, 40, 14 
}
